# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://user:password@localhost:27017/devops-dashboard

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=your-jenkins-username-here
JENKINS_API_TOKEN=your-jenkins-api-token-here

CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=sqa_your_sonarqube_token_here

GRAFANA_URL=http://localhost/grafana
GRAFANA_API_KEY=glsa_your_grafana_api_key_here

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173/

# Rate Limiting (for future use)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100